# Only application code and required non-sensitive resources are versioned.
/*
!/.gitignore
!/README.md
!/package.json
!/start.command
!/server.py
!/index.html
!/style.css
!/app.js
!/font-tools.js
!/assets.js
!/asset-tree.js
!/locate.js
!/core.js
!/deck.js
!/demo.js
!/report.js
!/pptx.js
!/windows.js
!/tests/
/tests/*
!/tests/*.test.mjs
!/tests/test_server.py
!/tests/browser.html
!/tests/browser.js
!/tests/folders.html
!/tests/folders.js
!/tests/pptx.html
!/tests/pptx-browser.js
!/tests/locate.html
!/tests/locate-browser.js
!/scripts/
/scripts/*
!/scripts/extract_pptx_example.py
!/scripts/verify_pptx_example.py
!/assets/
/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/OFL-Figtree.txt
!/assets/fonts/figtree-latin.woff2
!/assets/fonts/figtree-latin-ext.woff2

# Explicit protection for local data, exports, credentials, and backups.
/examples/
/evidence/
/chat_history.md
/.local-backups/
/build/
/dist/
/output/
/node_modules/
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*
**/*token*
**/*.figure.json
**/*.sources.json
**/*.pptx
**/*.ppt
**/*.pdf
**/*.zip
**/~$*
