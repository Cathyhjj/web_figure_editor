!/assets/fonts/figtree-latin-ext.woff2

# Explicit protection for local data, exports, credentials, and backups.
/examples/
/evidence/
/chat_history.md
/.local-backups/
/build/
/dist/
/output/
/node_modules/
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*
**/*token*
**/*.figure.json
**/*.sources.json
**/*.pptx
**/*.ppt
**/*.pdf
**/*.zip
